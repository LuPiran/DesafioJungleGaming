{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor — Jungle Gaming technical challenge",
  "license": "UNLICENSED",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "NODE_ENV=production bun run src/main.ts",
    "migration:up": "bunx mikro-orm migration:up",
    "migration:down": "bunx mikro-orm migration:down",
    "migration:pending": "bunx mikro-orm migration:pending",
    "migration:create": "bunx mikro-orm migration:create",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 120000 --max-concurrency 1",
    "test:concurrency": "bun test test/concurrency --timeout 180000 --max-concurrency 1",
    "test:all": "bun test --timeout 180000 --max-concurrency 1",
    "test:load": "bun run test/load/load-test.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.864.0",
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/decorators": "^7.1.14",
    "@mikro-orm/migrations": "^7.1.14",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.1.14",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/terminus": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.5.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.1.14",
    "@nestjs/testing": "^11.1.6",
    "@testcontainers/localstack": "^11.5.1",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.3",
    "testcontainers": "^11.5.1",
    "typescript": "^5.9.2"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/infrastructure/persistence/mikro-orm/mikro-orm.config.ts"
    ]
  }
}
